{
  "version": 2,
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "main.py"
    }
  ],
  "env": {
    "HF_HOME": "/tmp/huggingface",
    "HF_HUB_CACHE": "/tmp/huggingface/hub",
    "HF_HUB_DISABLE_SYMLINKS_WARNING": "1",
    "HF_HUB_ENABLE_HF_TRANSFER": "0",
    "TORCH_HOME": "/tmp/torch",
    "TMPDIR": "/tmp",
    "STORAGE_DIR": "/tmp/storage",
    "PYTHONPYCACHEPREFIX": "/tmp/pycache"
  }
}

